soong_config_module_type {
    name: "sm8150_tablet_settings_app",
    module_type: "android_app",
    config_namespace: "XIAOMI_SM8150_TABLET",
    value_variables: ["settings_config"],
    properties: ["static_libs"],
}

sm8150_tablet_settings_app {
    name: "XiaomiTabletSettings",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "org.lineageos.settings.resources",
        "custom.hardware.hwcontrol-java",
    ],

    soong_config_variables: {
        settings_config: {
            static_libs: ["%s"],
            conditions_default: {
                static_libs: ["sm8150_tablet_settings_defaults"],
            },
        },
    },

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

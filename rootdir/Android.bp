soong_config_module_type {
    name: "sm8150_device_rootdir_sh_binary",
    module_type: "sh_binary",
    config_namespace: "XIAOMI_MSMNILE_ROOTDIR",
    bool_variables: ["DEVICE_ROOTDIR"],
    properties: ["enabled"],
}

//
// Copyright (C) 2022 The LineageOS Project
//
// SPDX-License-Identifier: Apache-2.0
//

// Init scripts
sh_binary {
    name: "init.class_main.sh",
    src: "bin/init.class_main.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.class_core.sh",
    src: "bin/init.qcom.class_core.sh",
    vendor: true,
}

sm8150_device_rootdir_sh_binary {
    name: "init.qcom.early_boot.sh",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    src: "bin/init.qcom.early_boot.sh",
    vendor: true,
}

sm8150_device_rootdir_sh_binary {
    name: "init.qcom.post_boot.sh",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    src: "bin/init.qcom.post_boot.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.sh",
    src: "bin/init.qcom.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.usb.sh",
    src: "bin/init.qcom.usb.sh",
    vendor: true,
}

sh_binary {
    name: "init.qti.chg_policy.sh",
    src: "bin/init.qti.chg_policy.sh",
    vendor: true,
}

sh_binary {
    name: "init.qti.dcvs.sh",
    src: "bin/init.qti.dcvs.sh",
    vendor: true,
}

// fstab
soong_config_module_type {
    name: "xiaomi_msmnile_rootdir_prebuilt_etc",
    module_type: "prebuilt_etc",
    config_namespace: "XIAOMI_MSMNILE_ROOTDIR",
    variables: ["PARTITION_SCHEME"],
    bool_variables: ["DEVICE_ROOTDIR"],
    properties: ["src", "enabled"],
}

soong_config_string_variable {
    name: "PARTITION_SCHEME",
    values: ["dynamic", "legacy"],
}

xiaomi_msmnile_rootdir_prebuilt_etc {
    name: "fstab.qcom",
    soong_config_variables: {
        DEVICE_ROOTDIR: { enabled: false },
        PARTITION_SCHEME: {
            dynamic: {
                src: "etc/fstab_dynamic.qcom",
            },
            legacy: {
                src: "etc/fstab_legacy.qcom",
            },
            conditions_default: {
                src: "etc/fstab_dynamic.qcom",
            },
        },
    },
    vendor: true,
}

// Init configuration files
xiaomi_msmnile_rootdir_prebuilt_etc {
    name: "init.qcom.power.rc",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    src: "etc/init.qcom.power.rc",
    sub_dir: "init/hw",
    vendor: true,
}

xiaomi_msmnile_rootdir_prebuilt_etc {
    name: "init.qcom.rc",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    src: "etc/init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

xiaomi_msmnile_rootdir_prebuilt_etc {
    name: "init.qcom.usb.rc",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    src: "etc/init.qcom.usb.rc",
    sub_dir: "init/hw",
    vendor: true,
}

xiaomi_msmnile_rootdir_prebuilt_etc {
    name: "init.target.rc",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    src: "etc/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

xiaomi_msmnile_rootdir_prebuilt_etc {
    name: "init.xiaomi.rc",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    src: "etc/init.xiaomi.rc",
    sub_dir: "init/hw",
    vendor: true,
}

xiaomi_msmnile_rootdir_prebuilt_etc {
    name: "ueventd.qcom.rc",
    soong_config_variables: { DEVICE_ROOTDIR: { enabled: false } },
    filename: "ueventd.rc",
    src: "etc/ueventd.qcom.rc",
    vendor: true,
}
